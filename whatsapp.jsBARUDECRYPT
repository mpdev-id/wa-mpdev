const sessions = new Map();
const retries = new Map();

const SESSIONS_BASE_PATH = 'sessions';
const STORE_JSON_SUFFIX = '_store.json';
const LEGACY_PREFIX = 'legacy_';
const MODERN_PREFIX = 'md_';
const JSON_SUFFIX = '.json';
const WHATSAPP_NET_SUFFIX = '@s.whatsapp.net';
const WHATSAPP_GROUP_SUFFIX = '@g.us';

const sessionsDir = (filename = '') => {
    return join(currentDirname, SESSIONS_BASE_PATH, filename);
};

const isSessionExists = (sessionId) => {
    return sessions.has(sessionId);
};

const shouldReconnect = (sessionId) => {
    let maxRetriesConfig = parseInt(process.env.MAX_RETRIES ?? '0');
    let currentAttempt = retries.get(sessionId) ?? 0;
    
    maxRetriesConfig = maxRetriesConfig < 1 ? 1 : maxRetriesConfig; // Ensure at least 1 retry if configured non-negative
    
    if (currentAttempt < maxRetriesConfig) {
        currentAttempt++;
        console.log('Reconnecting...', {
            attempts: currentAttempt,
            sessionId: sessionId
        });
        retries.set(sessionId, currentAttempt);
        return true;
    }
    return false;
};

const createSession = async (sessionId, isLegacy = false, res = null) => {
    const sessionFileID = (isLegacy ? LEGACY_PREFIX : MODERN_PREFIX) + sessionId;
    // For useMultiFileAuthState, it expects a directory name, so we don't add .json here.
    // The .json was part of the obfuscated _0x22a9a8 but likely for a different purpose or misdirection.
    // The actual auth path will be like 'sessions/md_sessionid' or 'sessions/legacy_sessionid'

    const logger = pino({
        level: 'debug'
    });
    const store = makeInMemoryStore({
        logger: logger
    });

    let authState, saveCredsHandler;
    if (isLegacy) {
        // Legacy sessions might not use multi-file auth state or have a different mechanism.
        // The original code had an empty if block for isLegacy, implying authState and saveCredsHandler
        // might remain undefined, which could be intentional if legacy mode is ephemeral or handles auth differently.
    } else {
        ({ state: authState, saveCreds: saveCredsHandler } = await useMultiFileAuthState(sessionsDir(sessionFileID)));
    }

    const connectionOptions = {
        auth: authState,
        version: [7, 2, 2416], // Example version, original was obfuscated
        printQRInTerminal: true,
        logger: logger,
        browser: Browsers.ubuntu('Chrome'),
        patchMessageBeforeSending: (message) => {
            const isButtonOrListMessage = !!(message.buttonsMessage || message.listMessage);
            if (isButtonOrListMessage) {
                message = {
                    viewOnceMessage: {
                        message: {
                            messageContextInfo: {
                                deviceListMetadataVersion: 2,
                                deviceListMetadata: {}
                            },
                            ...message
                        }
                    }
                };
            }
            return message;
        }
    };

    const waSocket = Baileys.default(connectionOptions); // Assuming 'default' is the main export used

    if (!isLegacy) {
        store.readFromFile(sessionsDir(sessionId + STORE_JSON_SUFFIX)); // e.g. sessions/session123_store.json
        store.bind(waSocket.ev);
    }

    sessions.set(sessionId, {
        ...waSocket,
        store: store,
        isLegacy: isLegacy
    });

    waSocket.ev.on('creds.update', saveCredsHandler); // saveCredsHandler will be undefined for isLegacy if not set above

    waSocket.ev.on('chats.set', ({ chats }) => {
        if (isLegacy) { // Original logic: only for legacy, store chats
             store.chats.insertIfAbsent(...chats);
        }
    });

    waSocket.ev.on('messages.upsert', async (update) => {
        try {
            const firstMessage = update.messages[0];
            if (firstMessage.key.fromMe === false && update.type === 'notify') {
                const remoteJidParts = firstMessage.key.remoteJid.split('@');
                const remoteHost = remoteJidParts[1] ?? null;
                const isGroupMessage = remoteHost === WHATSAPP_GROUP_SUFFIX.substring(1); // e.g. "g.us"

                if (firstMessage && !isGroupMessage) { // Only process if not empty and not a group message
                    const webhookPayload = {
                        remote_id: firstMessage.key.remoteJid,
                        session_id: sessionId,
                        message_id: firstMessage.key.id,
                        message: firstMessage.message
                    };
                    sendWebhook(sessionId, webhookPayload);
                }
            }
        } catch (error) {
            // Original code had an empty catch
            logger.error({ error, sessionId, event: 'messages.upsert' }, "Error processing message upsert");
        }
    });

    waSocket.ev.on('connection.update', async (updateData) => {
        const { connection, lastDisconnect } = updateData;
        const statusCode = lastDisconnect?.error?.output?.statusCode;

        if (connection === 'close') {
            retries.delete(sessionId); // Clear retries on successful connection previously then close
        }

        if (connection === 'close') {
            if (statusCode === DisconnectReason.loggedOut || !shouldReconnect(sessionId)) {
                if (res && !res.headersSent) {
                    sendResponse(res, 500, false, 'Unable to create session.');
                }
                deleteSession(sessionId, isLegacy);
                setDeviceStatus(sessionId, 'logout'); // Send status after deleting
                return;
            }

            setTimeout(() => {
                createSession(sessionId, isLegacy, res);
            }, statusCode === DisconnectReason.restartRequired ? 0 : parseInt(process.env.RECONNECT_INTERVAL ?? '0'));
        
        } else if (connection === 'open') {
            setDeviceStatus(sessionId, 'isauthorised'); // Custom status
        }


        if (updateData.qr) {
            if (res && !res.headersSent) {
                try {
                    const qrDataURL = await toDataURL(updateData.qr);
                    sendResponse(res, 200, true, 'QR code received, please scan the QR code.', {
                        qr: qrDataURL
                    });
                    return; // Don't proceed to logout if QR is being sent
                } catch (qrError) {
                    logger.error({ qrError, sessionId }, "Error generating QR code data URL");
                    sendResponse(res, 500, false, 'Unable to create QR code.');
                    // Fall through to logout/cleanup if QR generation fails
                }
            }
            // If QR is generated but no response object (e.g. initial startup), or if res was already sent
            // We should probably ensure the session is cleaned up if it can't proceed.
            try {
                await waSocket.logout();
            } catch (logoutError) {
                logger.error({ logoutError, sessionId }, "Error during logout after QR display.");
            } finally {
                deleteSession(sessionId, isLegacy); // Clean up session if QR was shown but not scanned
            }
        }
    });
};

