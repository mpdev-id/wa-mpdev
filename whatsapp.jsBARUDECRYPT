const getSession = (sessionId) => {
    return sessions.get(sessionId) ?? null;
};

const setDeviceStatus = (sessionId, status) => {
    // status could be 'isauthorised' (string) or 0 (number for logout)
    // Original used 0 for logout in deleteSession
    const statusValue = status === 'logout' ? 0 : status; // Normalize 'logout' to 0 if needed or keep as string
    const apiUrl = `${process.env.APP_URL}/api/set-device-status/${sessionId}/${statusValue}`;
    axios.post(apiUrl)
        .catch(err => console.error("Failed to set device status:", err.message));
};

const sendWebhook = (sessionId, payload) => {
    const webhookUrl = `${process.env.APP_URL}/api/send-webhook/${sessionId}`;
    try {
        axios.post(webhookUrl, {
            from: payload.remote_id,
            message_id: payload.message_id,
            message: payload.message
        })
        .then(function(response) {
            if (response.status === 200 && response.data) { // Check for data
                const session = getSession(response.data.session_id); // Assuming response.data has session_id
                if (session && response.data.receiver && response.data.message) {
                     sendMessage(session, response.data.receiver, response.data.message, 0);
                }
            }
        })
        .catch(function(error) {
            // logger.error({error, sessionId}, "Error sending webhook or processing its response");
        });
    } catch (e) {
        // logger.error({e, sessionId}, "Catastrophic error in sendWebhook");
    }
};

const deleteSession = (sessionId, isLegacy = false) => {
    // Construct dir name based on legacy status, used by useMultiFileAuthState
    const sessionAuthDir = (isLegacy ? LEGACY_PREFIX : MODERN_PREFIX) + sessionId; 
    const sessionStoreFile = sessionId + STORE_JSON_SUFFIX; // e.g. session123_store.json

    const options = {
        force: true,
        recursive: true
    };

    try {
        rmSync(sessionsDir(sessionAuthDir), options);
    } catch (e) { console.error(`Error deleting auth dir ${sessionsDir(sessionAuthDir)}: ${e.message}`); }
    try {
        rmSync(sessionsDir(sessionStoreFile), options);
    } catch (e) { console.error(`Error deleting store file ${sessionsDir(sessionStoreFile)}: ${e.message}`); }
    
    sessions.delete(sessionId);
    retries.delete(sessionId);
    // setDeviceStatus(sessionId, 0); // Original was 0 for logout, called in connection.update now
};

const getChatList = (sessionId, isGroup = false) => {
    const session = getSession(sessionId);
    if (!session) return [];

    const suffixToFilter = isGroup ? WHATSAPP_GROUP_SUFFIX : WHATSAPP_NET_SUFFIX;
    return session.store.chats.filter(chat => {
        return chat.id.endsWith(suffixToFilter);
    });
};

const isExists = async (session, id, isGroup = false) => {
    try {
        let result;
        if (isGroup) {
            // For groups, groupMetadata might be more reliable if the ID is already a group ID
            result = await session.groupMetadata(id); // This throws if not a group or not found
            return Boolean(result && result.id); // Check if ID exists in metadata
        }
        // For individual numbers
        if (session.isauthorised) { // 'isauthorised' was the original string
             // Newer Baileys versions might return [ { exists: true/false, jid: string } ]
            const onWhatsAppResult = await session.onWhatsApp(id);
            if (Array.isArray(onWhatsAppResult) && onWhatsAppResult.length > 0) {
                return onWhatsAppResult[0].exists;
            } else if (onWhatsAppResult && typeof onWhatsAppResult.exists !== 'undefined') { // Older Baileys
                 return onWhatsAppResult.exists;
            }
            return false; // Not found or unexpected format
        } else { // For legacy or if session.onWhatsApp is different
            [result] = await session.onWhatsApp(id); // Original structure for legacy
            return result.exists;
        }
    } catch (error) {
        // logger.error({error, sessionId: session?.id, id, isGroup}, "Error in isExists");
        return false;
    }
};

const sendMessage = async (session, remoteJid, messageContent, deliveryDelay = 1000) => {
    try {
        await delay(parseInt(deliveryDelay));
        return await session.sendMessage(remoteJid, messageContent);
    } catch (error) {
        // logger.error({error, remoteJid}, "Error sending message");
        return Promise.reject(null); // Or throw error
    }
};

const formatPhone = (phoneNumber) => {
    if (phoneNumber.endsWith(WHATSAPP_NET_SUFFIX)) return phoneNumber;
    let digitsOnly = phoneNumber.replace(/\D/g, '');
    
     if (digitsOnly.startsWith('0')) {
        digitsOnly = '62' + digitsOnly.substr(1);
    }

    if (!digitsOnly.endsWith('@c.us')) {
        digitsOnly += '@c.us';
    }
    
    return digitsOnly + WHATSAPP_NET_SUFFIX;
};

