const cleanup = () => {
    console.log('Running cleanup before exit.');
    sessions.forEach((session, sessionId) => {
        if (!session.isLegacy && session.store && typeof session.store.writeToFile === 'function') {
            // For non-legacy, save store to file. Auth creds are saved by 'creds.update' handler.
            session.store.writeToFile(sessionsDir(sessionId + STORE_JSON_SUFFIX));
        }
    });
};

const init = () => {
    readdir(sessionsDir(), (err, files) => {
        if (err) {
            console.error("Failed to read sessions directory:", err);
            throw err; // Or handle more gracefully
        }
        for (const fileOrDirName of files) {
            // We are looking for auth directories like 'md_sessionid' or 'legacy_sessionid'
            // We ignore '_store.json' files at this stage
            if (!fileOrDirName.startsWith(MODERN_PREFIX) && !fileOrDirName.startsWith(LEGACY_PREFIX)) {
                continue;
            }
            if (fileOrDirName.endsWith(STORE_JSON_SUFFIX) || fileOrDirName.endsWith(JSON_SUFFIX)) { 
                // This check might be redundant if startsWith already filters correctly
                // but ensures we don't try to treat a .json file as a session ID dir.
                continue;
            }

            // At this point, fileOrDirName should be an auth directory name
            // e.g., "md_someid" or "legacy_anotherid"
            
            const isLegacySession = fileOrDirName.startsWith(LEGACY_PREFIX);
            const prefixLength = isLegacySession ? LEGACY_PREFIX.length : MODERN_PREFIX.length;
            const sessionId = fileOrDirName.substring(prefixLength);
            
            if (sessionId) { // Ensure sessionId is not empty
                console.log(`Initializing session: ${sessionId}, Legacy: ${isLegacySession}`);
                createSession(sessionId, isLegacySession);
            }
        }
    });
};

